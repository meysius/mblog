DATABASE_URL=postgres://mblog:mblog@localhost:5433/mblog

# Uploaded images: "local" (the default) keeps them in MEDIA_DIR, "s3" in a bucket.
# See "Image storage" in the README.
# MEDIA_STORAGE=local
# MEDIA_DIR=./uploads

# MEDIA_STORAGE=s3
# S3_BUCKET=mblog-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional, read at build time: browsers load images straight from the public bucket.
# NEXT_PUBLIC_MEDIA_URL=https://media.example.com
