DATABASE_URL=postgres://postgres:postgres@localhost:5432/mblog

# The site's public address, for canonical links, share previews, the sitemap and
# the RSS feed. Required for production builds; development uses http://localhost:3000.
# SITE_URL=https://example.com

# Uploaded images: "local" (the default) keeps them in MEDIA_DIR, "s3" in a bucket.
# See "Image storage" in the README.
# MEDIA_STORAGE=local
# MEDIA_DIR=./uploads

# MEDIA_STORAGE=s3
# S3_BUCKET=mblog-media
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Optional, read at build time: browsers load images straight from the public bucket.
# NEXT_PUBLIC_MEDIA_URL=https://media.example.com

# Email, for password reset links. See "Email" in the README. Without these,
# development prints each email to the console.
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=2525
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Your Name <support@mail.example.com>"

# Production deploys only (deploy/README.md): GitHub's release webhook, the file it
# asks the server to deploy through, and the token for /hooks/revalidate.
# GITHUB_WEBHOOK_SECRET=
# DEPLOY_REQUEST_FILE=/opt/mblog/shared/deploy-requested
# REVALIDATE_SECRET=
