[Unit]
Description=Deploy when GitHub's release webhook reaches the app

# The app writes this file after checking the webhook's signature
# (src/app/hooks/github/route.ts). It holds at most the commit GitHub just
# published, which only tells the deploy how long to wait for Latest to catch
# up. The deploy looks up the Latest release on GitHub itself.
[Path]
PathChanged=/opt/mblog/shared/deploy-requested
Unit=mblog-deploy.service

[Install]
WantedBy=multi-user.target
